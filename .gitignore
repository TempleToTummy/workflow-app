# dependencies
/node_modules

# next.js
/.next
/out

# production
/build

# database
/prisma/dev.db
/prisma/dev.db-journal

# local object storage (simulated cloud bucket — see src/lib/storage.ts)
/.storage

# local Claude Code settings — machine-specific, and the permission allowlist
# can embed secrets from commands that were approved
.claude/settings.local.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
# .env holds real secrets (CRON_SECRET, EMAIL_INBOUND_SECRET, the database
# URL) and must never be committed. .env.example is the tracked template.
.env
.env*.local
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# backups (pre-restore snapshots and CLI output) — contain every client's data
/backups
