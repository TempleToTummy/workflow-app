# Copy to deploy/oci/.env on the server and fill in. .env is gitignored.
# Both containers read this file. See ../../.env.example for what every app
# setting does in detail.

# --- Domain and HTTPS ------------------------------------------------------
# The hostname staff and clients use. Its DNS A record must point at the VM's
# public IP before the first start, or Caddy can't get a certificate.
DOMAIN="workflow.yourfirm.com"
# Let's Encrypt sends certificate-expiry warnings here.
ACME_EMAIL="it@yourfirm.com"
# Used for password-reset and client request links. Must match DOMAIN.
APP_URL="https://workflow.yourfirm.com"

# --- Database --------------------------------------------------------------
# MySQL HeatWave on its private IP, logging in as the app's own user (never the
# admin one). If the password has anything but letters and digits, it must be
# URL-encoded here. sslaccept=accept_invalid_certs turns on encryption (Prisma
# doesn't by default, and HeatWave may require it); the certificate isn't
# checked, which is acceptable on the VCN's private network. The image is
# built for this engine (DB_PROVIDER).
DB_PROVIDER="mysql"
DATABASE_URL="mysql://workflow_app:PASSWORD@10.0.1.212:3306/ktaxdb?sslaccept=accept_invalid_certs"
# Without a database server, SQLite on the VM's disk also works:
#   DB_PROVIDER="sqlite"
#   DATABASE_URL="file:/data/workflow.db"

# --- First admin -----------------------------------------------------------
# On the first start the server log prints a one-time link for this person to
# set their password (deploy/oci/ops.sh logs). No default password exists.
FIRST_ADMIN_EMAIL="owner@yourfirm.com"
FIRST_ADMIN_NAME="Firm Owner"

# --- Files and backups -----------------------------------------------------
# Paths are inside the container; compose.yaml maps /data to
# /srv/workflow/data on the VM.
BACKUP_DIR="/data/backups"
STORAGE_DRIVER="local"

# --- Secrets (generate on the server; see README.md step 8) ---------------
# LOSING THE TWO ENCRYPTION KEYS LOSES THE DATA. Keep a copy in the firm's
# password manager before the first upload.
DATA_ENCRYPTION_KEYS=""
DATA_INDEX_KEY=""
AUTH_SECRET=""
CRON_SECRET=""

# --- Email -----------------------------------------------------------------
# Without RESEND_API_KEY, email is recorded but not sent.
# RESEND_API_KEY=""
EMAIL_FROM="workflow@yourfirm.com"
EMAIL_FROM_NAME="Workflow"
