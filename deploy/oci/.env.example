# Copy to deploy/oci/.env on the server and fill in. .env is gitignored.
# Both containers read this file. See ../../.env.example for what every app
# setting does in detail.

# --- Domain and HTTPS ------------------------------------------------------
# The hostname staff and clients use. Its DNS A record must point at the VM's
# public IP before the first start, or Caddy can't get a certificate.
DOMAIN="workflow.yourfirm.com"
# Let's Encrypt sends certificate-expiry warnings here.
ACME_EMAIL="it@yourfirm.com"
# Used for password-reset and client request links. Must match DOMAIN.
APP_URL="https://workflow.yourfirm.com"

# --- Data ------------------------------------------------------------------
# Paths are inside the container; compose.yaml maps /data to
# /srv/workflow/data on the VM.
DATABASE_URL="file:/data/workflow.db"
BACKUP_DIR="/data/backups"
STORAGE_DRIVER="local"

# --- Secrets (generate on the server; see README.md step 8) ---------------
# LOSING THE TWO ENCRYPTION KEYS LOSES THE DATA. Keep a copy in the firm's
# password manager before the first upload.
DATA_ENCRYPTION_KEYS=""
DATA_INDEX_KEY=""
AUTH_SECRET=""
CRON_SECRET=""

# --- Email -----------------------------------------------------------------
# Without RESEND_API_KEY, email is recorded but not sent.
# RESEND_API_KEY=""
EMAIL_FROM="workflow@yourfirm.com"
EMAIL_FROM_NAME="Workflow"
