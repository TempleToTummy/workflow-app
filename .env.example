# Copy to .env and fill in. .env is gitignored; this file is the template.

# --- Database ----------------------------------------------------------
# Local SQLite needs no setup. For Supabase/Postgres, also change the
# datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# --- Scheduled work generation -----------------------------------------
# Shared secret for POST /api/cron/generate-periods. Your scheduler sends it
# as "Authorization: Bearer <secret>". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Set to "off" to disable the lazy catch-up that runs work generation on
# dashboard load when cron hasn't run recently.
# PERIOD_AUTOGEN=off

# --- Email: sending ----------------------------------------------------
# With no RESEND_API_KEY the app records messages without delivering them and
# says so in the UI. Set the key to send for real.
# RESEND_API_KEY="re_..."
EMAIL_FROM="workflow@example.com"
EMAIL_FROM_NAME="Workflow"

# --- Email: receiving replies ------------------------------------------
# A catch-all inbound route on this domain, pointed at
# POST /api/email/inbound. The secret verifies the webhook signature; with it
# unset the endpoint refuses everything.
EMAIL_INBOUND_DOMAIN=""
EMAIL_INBOUND_PREFIX="reply"
EMAIL_INBOUND_SECRET=""

# --- App ---------------------------------------------------------------
# Base URL used to build password-reset links. Falls back to the request's own
# host; set it explicitly when running behind a proxy.
# APP_URL="https://workflow.yourfirm.com"
