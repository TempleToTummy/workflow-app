# Copy to .env and fill in. .env is gitignored; this file is the template.

# --- Database ----------------------------------------------------------
# Local SQLite needs no setup. Production images are built for their engine
# with the DB_PROVIDER build arg (scripts/schema-provider.ts) — don't edit the
# provider in prisma/schema.prisma by hand.
#
# MySQL (OCI MySQL HeatWave; see deploy/oci/): DB_PROVIDER=mysql and
#   DATABASE_URL="mysql://<user>:<password>@<private-ip>:3306/<db>?sslaccept=accept_invalid_certs"
#
# Supabase/Postgres: DB_PROVIDER=postgresql, the connection string from
# Supabase → Connect, and keep sslmode=require on it:
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres?sslmode=require"
# Then run supabase/security.sql (see SECURITY.md) — without it, Supabase's
# public REST API can read every table.
DATABASE_URL="file:./dev.db"

# --- Encryption at rest (REQUIRED in production) ------------------------
# Encrypts every uploaded file, every tax ID and SSN, and every backup with
# AES-256-GCM. See SECURITY.md. In production the app refuses to store a file
# or a tax ID without these. In development, leaving BOTH unset uses a public
# development key — never put real client data in an environment like that.
#
# A key ring: "<keyId>:<32 random bytes, base64>", comma-separated. The FIRST
# key encrypts new data; later ones are kept only so older data still opens.
# Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate: add the new key FIRST, deploy, run
# `npm run security:encrypt -- --apply`, then remove the old key.
#
# LOSING THESE KEYS LOSES THE DATA. Store a copy outside this server and
# outside Supabase (the firm's password manager or a KMS). Never give them a
# NEXT_PUBLIC_ prefix — the app refuses to start if you do.
# DATA_ENCRYPTION_KEYS="2026-09:<base64 key>"
# A separate key for the tax ID lookup index. Set once; never rotate it.
# DATA_INDEX_KEY="<base64 key>"

# --- File storage --------------------------------------------------------
# With SUPABASE_URL set, files go to a PRIVATE Supabase Storage bucket
# (create it with supabase/security.sql). Otherwise they go to ./.storage on
# this machine. Either way what's stored is ciphertext.
# The service-role key bypasses all Supabase security: server-side only,
# never NEXT_PUBLIC_, never committed. (A new-style "sb_secret_…" key also
# works here.)
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# STORAGE_BUCKET="workflow-files"
# STORAGE_DRIVER="supabase"   # or "local"; defaults from SUPABASE_URL

# --- Scheduled work generation -----------------------------------------
# Shared secret for POST /api/cron/generate-periods. Your scheduler sends it
# as "Authorization: Bearer <secret>". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Set to "off" to disable the lazy catch-up that runs work generation on
# dashboard load when cron hasn't run recently.
# PERIOD_AUTOGEN=off

# --- Email: sending ----------------------------------------------------
# With no RESEND_API_KEY the app records messages without delivering them and
# says so in the UI. Set the key to send for real.
# RESEND_API_KEY="re_..."
EMAIL_FROM="workflow@example.com"
EMAIL_FROM_NAME="Workflow"

# --- Email: receiving replies ------------------------------------------
# A catch-all inbound route on this domain, pointed at
# POST /api/email/inbound. The secret verifies the webhook signature; with it
# unset the endpoint refuses everything.
EMAIL_INBOUND_DOMAIN=""
EMAIL_INBOUND_PREFIX="reply"
EMAIL_INBOUND_SECRET=""

# --- App ---------------------------------------------------------------
# Base URL used to build password-reset links AND the client-facing request
# links (/r/<token>) that go out to clients. Falls back to the request's own
# host; set it explicitly when running behind a proxy, or clients will receive
# links pointing at an internal hostname they can't reach.
# APP_URL="https://workflow.yourfirm.com"

# --- Security ------------------------------------------------------------
# Encrypts two-factor (TOTP) secrets at rest. Optional — without it they're
# stored unencrypted and the Account page says so. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Don't change it once people have turned on 2FA: their secrets become
# unreadable and each would have to set 2FA up again.
AUTH_SECRET=""

# --- Backups -------------------------------------------------------------
# Where `npm run db:backup` writes and where the automatic pre-restore
# snapshots go. Defaults to ./backups (gitignored). Point it at storage that
# outlives this server. Backups are encrypted with DATA_ENCRYPTION_KEYS, so
# restoring one needs a server with the same keys.
# BACKUP_DIR="/mnt/backups/workflow"
