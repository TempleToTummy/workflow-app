// Prisma schema for the workflow dashboard.
//
// This mirrors the real KTAX data model found in the APEX export, adapted
// to Postgres/Prisma conventions:
//   - Project is a recurring WORKFLOW TEMPLATE, not a single task.
//   - ProjectSubTask + ProjectTaskMap define an ordered checklist per project.
//   - ProjectClientMap assigns a project to a client (turns the template on).
//   - ClientActivity is the actual unit of work: one client, one project,
//     one subtask, one accounting period. This is what staff check off.
//   - AccountingPeriod + ProjectRecurring drive the monthly/quarterly/annual
//     cadence and period rollover that the original app's triggers handled.
//
// Auth: the original app's login tables (APP_USER, APP_ROLES, reset tokens)
// were NOT carried over, and EMPLOYEES.EMPLOYEE_PASSWORD (plain text in the
// source) was never migrated. Auth is now self-contained instead: a Role enum
// + passwordHash/inviteToken fields on Employee, and a Session model, hashed
// with scrypt. See src/lib/auth.ts, src/lib/password.ts, src/proxy.ts.
//
// Left out of this first pass, deliberately:
//   - CLIENT_TAX_EXTENSION, US_STATE, MONTHS, and the backup/temp tables
//     (CLIENT_BKP_*, CORP_CONTACT_3162026, LIQ_LIC_TEMP). Can add these
//     back later if the workflow needs them.
//   - CORP_CONTACT.OWNER_SSN_NO is modeled as ssnEncrypted (String?) as a
//     placeholder: this needs application-level encryption before any real
//     SSNs go in it, it should never be stored as plain text.
//
// Runs on SQLite locally (zero setup). Switch provider to "postgresql" and
// point DATABASE_URL at Supabase when you're ready to deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // change to "postgresql" for Supabase / production
  url      = env("DATABASE_URL")
}

enum RecurringType {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum ActivityStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_REVIEW
  DONE
}

// A subtask under a ClientActivity step can be internal work (TEAM_TASK) or a
// request for the client to provide something (CLIENT_TASK). The distinction
// is presentational for now — there's no client portal or email yet.
enum SubtaskKind {
  TEAM_TASK
  CLIENT_TASK
}

// What a client is being asked to do through a tokenized link. UPLOAD backs
// "Document Received" (send us the bank statements); APPROVAL backs "Review
// done by Client" (sign off on the report we sent). Those are the two steps
// the firm spends the most time waiting on, which is why they're the two the
// link supports rather than a general-purpose portal.
enum ClientRequestKind {
  UPLOAD
  APPROVAL
}

// OPEN until the client acts. COMPLETED records that they did (an upload
// landed, or an approval decision came back). CANCELLED is a staff revoke —
// the link stops working immediately. There is deliberately no EXPIRED value:
// expiry is a timestamp, and deriving "expired" from it means a link can't be
// left in a lying state by a job that failed to run.
enum ClientRequestStatus {
  OPEN
  COMPLETED
  CANCELLED
}

// Two account types, nothing more for now. ADMIN gets the Admin Menu and user
// management; EMPLOYEE gets the operational app only.
enum Role {
  ADMIN
  EMPLOYEE
}

// --- Lookups -----------------------------------------------------------

model CorporationType {
  id      String   @id @default(cuid())
  name    String   @unique
  clients Client[]
}

model BusinessType {
  id      String   @id @default(cuid())
  name    String   @unique
  clients Client[]
}

model EmployeeType {
  id        String     @id @default(cuid())
  name      String     @unique
  employees Employee[]
}

// --- People --------------------------------------------------------------

model Client {
  id             String           @id @default(cuid())
  companyName    String
  corpTypeId     String?
  corpType       CorporationType? @relation(fields: [corpTypeId], references: [id])
  businessTypeId String?
  businessType   BusinessType?    @relation(fields: [businessTypeId], references: [id])
  address1       String?
  address2       String?
  city           String?
  zipcode        String?
  state          String?
  phone          String?
  fax            String?
  taxId          String?          @unique // was FIN_NO
  note           String?
  coRegDate      DateTime?
  coRegState     String?
  renewMonth     String?
  email          String?
  groupName      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  contacts           CorpContact[]
  projectAssignments ProjectClientMap[]
  activities         ClientActivity[]
  documents          Document[]
  assignmentNotes    AssignmentNote[]
  emails             EmailMessage[]
  timeEntries        TimeEntry[]
  clientRequests     ClientRequest[]
}

model CorpContact {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName    String?
  lastName     String?
  mobile       String?
  email        String?
  // Placeholder only. Needs real application-level encryption (or a KMS
  // backed column) before any real SSNs go in here, never plain text.
  ssnEncrypted String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id             String        @id @default(cuid())
  firstName      String
  lastName       String
  employeeTypeId String?
  employeeType   EmployeeType? @relation(fields: [employeeTypeId], references: [id])
  email          String        @unique // the login identity — required
  phone          String?
  mobile         String?
  country        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // --- Billing and capacity ---
  // The rate this person's time is billed at, in whole currency units per
  // hour. Null = not set, and every money figure derived from their time is
  // then shown as "—" rather than zero: a rate nobody entered is unknown, not
  // free. Each TimeEntry stamps the rate that applied when it was logged
  // (TimeEntry.rateSnapshot), so raising a rate never rewrites past billing.
  // Admin-only, in the UI and in every rollup that shows an amount.
  hourlyRate            Float?
  // How many minutes of work a week this person is expected to carry. The
  // workload view compares committed hours against it to show a load bar;
  // null just means the bar is hidden and the raw hours are shown instead.
  // Nothing in the app blocks an assignment for exceeding it — the point is to
  // make the number visible, not to enforce a quota.
  weeklyCapacityMinutes Int?

  // --- Auth ---
  // passwordHash null = the account is invite-pending (no login yet). An admin
  // creates the Employee row, sends the invite link, and the invitee sets the
  // password via /invite/<token>. See src/lib/auth.ts.
  role                 Role      @default(EMPLOYEE)
  passwordHash         String?
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?
  sessions             Session[]

  // Password reset. Unlike inviteToken, only a SHA-256 hash of the reset token
  // is stored: the raw token goes out by email and is never needed again, so
  // there's no reason for a database read to be enough to take over an
  // account. inviteToken predates this and is still stored raw — it should be
  // migrated the same way.
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  // Set whenever the password changes (reset, invite acceptance, revoke), so
  // "when did this account last change hands" is answerable.
  passwordChangedAt   DateTime?

  // Not present in the source schema, added so the dashboard can show
  // who's responsible for a given task.
  assignedActivities  ClientActivity[]
  completedActivities ClientActivity[]   @relation("ActivityCompletedBy")
  stepDefaults        ProjectTaskMap[]   @relation("StepDefaultAssignee")
  engagementDefaults  ProjectClientMap[] @relation("EngagementDefaultAssignee")
  uploadedDocuments   Document[]
  authoredNotes       AssignmentNote[]
  sentEmails          EmailMessage[]
  timeEntries         TimeEntry[]
  comments            TaskComment[]
  mentions            TaskCommentMention[]
  requestedFromClient ClientRequest[]      @relation("ClientRequestCreatedBy")
}

// A logged-in session. The cookie (wf_session) holds this row's id verbatim —
// it's a 256-bit random token, so it doesn't need separate hashing for this
// app. Deleting the Employee cascades their sessions.
model Session {
  id         String   @id
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

// --- Recurrence engine -----------------------------------------------------

model ProjectRecurring {
  id       String             @id @default(cuid())
  type     RecurringType      @unique
  periods  AccountingPeriod[]
  projects Project[]
}

model AccountingPeriod {
  name        String           @id // e.g. "2026-08" for a monthly period
  startDate   DateTime
  endDate     DateTime
  recurringId String
  recurring   ProjectRecurring @relation(fields: [recurringId], references: [id])

  activities ClientActivity[]

  @@index([startDate, endDate])
}

// --- Workflow templates ----------------------------------------------------

model Project {
  id            String           @id @default(cuid())
  name          String           @unique
  description   String?
  recurringId   String
  recurring     ProjectRecurring @relation(fields: [recurringId], references: [id])
  // The service's deadline rule: how many days AFTER the accounting period's
  // end date the work is actually due. 0 = due on the last day of the period
  // (the old hardcoded behaviour), 20 = sales tax due the 20th of the
  // following month, 105 = an individual return due Apr 15 for a Dec 31 year
  // end. Overridable per client (ProjectClientMap) and per step
  // (ProjectTaskMap). See src/lib/due-dates.ts.
  dueOffsetDays Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  subtasks          ProjectTaskMap[]
  clientAssignments ProjectClientMap[]
  activities        ClientActivity[]
  documents         Document[]
  assignmentNotes   AssignmentNote[]
  emails            EmailMessage[]
  timeEntries       TimeEntry[]
  clientRequests    ClientRequest[]
}

model ProjectSubTask {
  id   String  @id @default(cuid())
  name String
  note String?

  taskMaps   ProjectTaskMap[]
  activities ClientActivity[]
}

// The ordered checklist for a project: which subtasks, in what sequence.
model ProjectTaskMap {
  projectId         String
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subTaskId         String
  subTask           ProjectSubTask @relation(fields: [subTaskId], references: [id], onDelete: Cascade)
  sequence          Int // was TASK_SEQ_NO
  // Who normally does this step. Expresses a role or skill ("Reviewer Layer 2
  // is always Marcus"), so it wins over the engagement-level default.
  defaultAssigneeId String?
  defaultAssignee   Employee?      @relation("StepDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  // Internal milestone for this step, in days relative to the engagement's
  // due date. Negative = earlier (e.g. -7 to have review done a week before
  // the filing deadline). null = share the engagement's due date.
  dueOffsetDays     Int?
  // How long this step is expected to take, in minutes. The template's
  // estimate: it seeds ClientActivity.estimatedMinutes on every row generated
  // from here on, which is what lets the workload view answer "how many HOURS
  // is this person carrying" and not just "how many tasks". null = unknown,
  // and unknown is reported as unknown rather than folded in as zero.
  estimatedMinutes  Int?

  @@id([projectId, subTaskId])
}

// Turns a project "on" for a client. Creating one of these is what should
// generate the first period's ClientActivity rows (the source app did this
// with a trigger, here it belongs in the server action that creates the
// assignment).
model ProjectClientMap {
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id])
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id])
  active            Boolean   @default(true)
  createSubtask     Boolean   @default(true)
  startDate         DateTime?
  completedDate     DateTime?
  currentPeriod     String?
  // Who owns this client's work on this service. Fills in every step that
  // doesn't name its own specialist, so a rolled-forward period arrives
  // assigned instead of blank — which is what made someone re-assign the same
  // people to the same steps every single month.
  defaultAssigneeId String?
  defaultAssignee   Employee? @relation("EngagementDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  // Per-client override of Project.dueOffsetDays (this client negotiated a
  // different turnaround, or has an extension on file). null = inherit.
  dueOffsetDays     Int?
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@id([clientId, projectId])
}

// The real unit of work: one client, one project, one subtask, one period.
// Sequential completion (can't finish task 3 before task 1) and period
// rollover (advance to next period once everything here is Done) are
// business rules that live in the app layer now, not in DB triggers.
model ClientActivity {
  id                String           @id @default(cuid())
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id])
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id])
  subTaskId         String
  subTask           ProjectSubTask   @relation(fields: [subTaskId], references: [id])
  periodName        String
  period            AccountingPeriod @relation(fields: [periodName], references: [name])
  status            ActivityStatus   @default(NOT_STARTED)
  taskSeqNo         Int
  // Materialized from the due-date rules (project offset + client override +
  // step offset) at the moment the row is generated, so the dashboard can
  // sort and filter on it in the database instead of recomputing per render.
  // Recomputed whenever a rule changes — UNLESS dueDateOverridden is set,
  // which marks a date a human typed in by hand and must not be clobbered.
  dueDate           DateTime?
  dueDateOverridden Boolean          @default(false)
  // When this step was actually marked done, and by whom. updatedAt can't
  // answer that — any later edit to notes or assignee clobbers it — and for a
  // checklist with two reviewer sign-off steps, "who signed this off" has to
  // have an answer.
  completedAt       DateTime?
  completedById     String?
  completedBy       Employee?        @relation("ActivityCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  // Copied from the step template (ProjectTaskMap.estimatedMinutes) when the
  // row is generated, then editable per task — one client's data entry really
  // does take three times as long as another's. Materialized for the same
  // reason dueDate is: the workload view sums it in the database.
  estimatedMinutes  Int?
  // `notes` is the original single-string note field from the source app and
  // is kept as-is for the admin grid. It is NOT the discussion channel: two
  // people editing it in sequence means the second overwrites the first, which
  // is exactly why TaskComment exists. New conversation belongs there.
  notes             String?
  assigneeId        String?
  assignee          Employee?        @relation(fields: [assigneeId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  subtasks       ActivitySubtask[]
  comments       TaskComment[]
  timeEntries    TimeEntry[]
  clientRequests ClientRequest[]

  @@unique([clientId, projectId, subTaskId, periodName])
  @@index([status])
  @@index([dueDate])
}

// An ad-hoc checklist nested under one ClientActivity step. Advisory only: a
// subtask being open does NOT block the parent step from being marked DONE,
// and the sequential-completion rule in src/lib/workflow.ts is unchanged. The
// parent step just surfaces a done/total count.
model ActivitySubtask {
  id         String         @id @default(cuid())
  activityId String
  activity   ClientActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name       String
  kind       SubtaskKind    @default(TEAM_TASK)
  done       Boolean        @default(false)
  sequence   Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([activityId])
}

// A running note on one engagement (a client + project pair). Not scoped to an
// accounting period — notes carry across periods for the life of the
// assignment. Newest-first in the UI.
model AssignmentNote {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  projectId String
  project   Project   @relation(fields: [projectId], references: [id])
  body      String
  authorId  String?
  author    Employee? @relation(fields: [authorId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([clientId, projectId])
}

// A file attached to an engagement. Shaped like a cloud object-storage record
// on purpose: `bucket` + `storageKey` are the object address. Today
// LocalObjectStore (src/lib/storage.ts) writes the bytes under ./.storage/
// <bucket>/<storageKey>; swapping in a Supabase Storage backed ObjectStore
// later needs no schema change.
model Document {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])
  periodName   String? // which accounting period it belongs to, if any
  filename     String // original upload name, shown in the UI
  mimeType     String
  size         Int // bytes
  bucket       String    @default("workflow-files")
  storageKey   String    @unique
  uploadedById String?
  uploadedBy   Employee? @relation(fields: [uploadedById], references: [id])
  // Set when the CLIENT uploaded this through a tokenized request link rather
  // than a member of staff through the Files tab. uploadedById is null in that
  // case (no employee did it), so this is what distinguishes "nobody recorded
  // who uploaded it" from "the client uploaded it themselves".
  clientRequestId String?
  clientRequest   ClientRequest? @relation(fields: [clientRequestId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([clientId, projectId])
  @@index([clientRequestId])
}

// --- Scheduled work generation ---------------------------------------------

// One execution of a background job, kept so the firm can see that work is
// actually being generated (and what the last run did) instead of trusting an
// invisible cron. Today the only job is "period-generation"
// (src/lib/scheduler.ts), which opens each active engagement's next accounting
// period whether or not the previous one was finished — the app used to
// generate the next period ONLY as a side effect of someone ticking the last
// task done, so an engagement that fell behind silently stopped producing work.
model SchedulerRun {
  id                 String    @id @default(cuid())
  job                String // "period-generation"
  trigger            String // "cron" | "manual" | "auto"
  status             String // "RUNNING" | "SUCCESS" | "FAILED"
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  engagementsScanned Int       @default(0)
  periodsCreated     Int       @default(0)
  activitiesCreated  Int       @default(0)
  assignmentsClosed  Int       @default(0)
  dueDatesWritten    Int       @default(0)
  // Human-readable rundown of what happened, or the error if status FAILED.
  detail             String?

  @@index([job, startedAt])
}

// --- Email -----------------------------------------------------------------

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum EmailStatus {
  QUEUED // accepted by us, not handed to a provider yet
  SENT // the provider accepted it
  LOGGED // recorded only — no provider is configured, nothing was delivered
  FAILED // the provider rejected it (see `error`)
  DELIVERED // provider confirmed delivery
  BOUNCED // provider reported a bounce
  RECEIVED // inbound: a reply that arrived through the webhook
}

// One email, in or out. Messages hang off an engagement (client + project +
// period) when they have one, so correspondence sits next to the work it's
// about, but a message to a client with no project attached is also valid.
//
// Threading: every outbound message is given a `replyToken`, and its Reply-To
// header carries that token (see src/lib/email.ts). When the client replies,
// the inbound webhook pulls the token back out of the To: address and threads
// the reply onto the same `threadKey` — which is how a two-way conversation
// stays attached to the right engagement without guessing from the subject
// line. A reply that arrives with no recoverable token falls back to matching
// the sender's address against known client contacts.
model EmailMessage {
  id        String         @id @default(cuid())
  direction EmailDirection
  status    EmailStatus

  // Engagement context. All optional: a message can be client-only (no
  // project), or firm-level (no client at all, e.g. a test send).
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  periodName String?

  // Stable conversation id. Outbound seeds it; inbound replies inherit it.
  threadKey  String
  // The opaque token embedded in the Reply-To address of an outbound message.
  replyToken String? @unique
  // The provider's own id for the message, for support tickets and webhooks.
  providerId String?
  // Which transport handled it ("log", "resend"), so a message sent while
  // nothing was configured is distinguishable later.
  transport  String?

  fromEmail String
  fromName  String?
  toEmail   String
  toName    String?
  // Comma-separated. Kept as text: this app never needs to query by cc.
  cc        String?
  subject   String
  bodyText  String
  bodyHtml  String?

  templateKey String?
  sentById    String?
  sentBy      Employee? @relation(fields: [sentById], references: [id])

  error      String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  receivedAt DateTime?

  @@index([clientId, projectId])
  @@index([threadKey, createdAt])
  @@index([direction, createdAt])
  @@index([status])
}

// A reusable message. Bodies interpolate {{placeholders}} resolved from the
// engagement being written about — see renderTemplate in src/lib/email.ts.
// Built-in templates are seeded from the firm's real checklist steps
// ("Document Received", "Report Sent to Client", "Review done by Client") and
// can be edited; `builtIn` only marks where they came from.
model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  subject     String
  body        String
  builtIn     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Audit trail -------------------------------------------------------------

// An append-only record of who changed what, and when.
//
// The app had createdAt/updatedAt and nothing else, so "who marked Reviewer
// Layer 2 done, and when" had no answer — and updatedAt was clobbered by the
// next unrelated edit to the same row. For a firm whose checklists contain two
// reviewer sign-offs and a client approval, that gap matters the moment a
// client disputes something.
//
// Nothing here is a foreign key, on purpose. An audit row has to outlive the
// thing it describes: deleting a client, a project or an employee must not
// erase the history of what was done to it. Ids are kept for filtering and
// every row carries denormalized labels so it stays readable afterwards.
model AuditEvent {
  id String @id @default(cuid())

  // What was touched: "ClientActivity", "Employee", "Client", "Project", …
  entityType String
  entityId   String
  // Dotted verb: "status.changed", "assignee.changed", "password.reset", …
  action     String

  // Who did it. actorLabel survives the employee being deleted; actorId is
  // null for things the system did on its own (scheduled work generation).
  actorId    String?
  actorLabel String

  // One human sentence, written at record time so the log reads correctly even
  // after the underlying names change.
  summary   String
  fromValue String?
  toValue   String?

  // Engagement context, for the per-client and per-engagement history views.
  clientId     String?
  projectId    String?
  periodName   String?
  contextLabel String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([clientId, projectId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// --- Time tracking -----------------------------------------------------------

// One block of logged work. This is what billing, realization and "is this
// client profitable" are computed from, so a few things are deliberate:
//
//   - `minutes` is materialized, not derived per query. It's written from
//     startedAt/endedAt on the server when a timer stops, or typed directly
//     for a manual entry. Rollups sum a column instead of subtracting
//     timestamps across thousands of rows, and a manual entry doesn't need
//     fake start/end times invented for it.
//   - A running timer is `endedAt: null`. There is at most one of those per
//     employee, enforced in the action layer (src/lib/time-actions.ts), not
//     here — SQLite can't express a partial unique index through Prisma.
//   - `rateSnapshot` copies Employee.hourlyRate at write time. Raising
//     somebody's rate must not silently restate last quarter's billing, which
//     is exactly what recomputing from the employee row would do.
//   - The engagement columns are denormalized from the activity on purpose: a
//     rollup per client has to work without joining through ClientActivity,
//     and time logged against an engagement outlives any one task row.
model TimeEntry {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Engagement context. Kept even when the activity is gone, which is why
  // these are their own columns and activityId is nullable.
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  periodName String?
  // The specific checklist step the time was booked against, when there is
  // one. SetNull rather than Cascade: deleting a task must not delete the
  // record that somebody spent two hours on it.
  activityId String?
  activity   ClientActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  startedAt DateTime
  // null = the timer is still running. Nothing reads `minutes` for a running
  // entry; the elapsed time is computed from startedAt at render time.
  endedAt   DateTime?
  minutes   Int       @default(0)

  // Non-billable time is still time — internal admin, training, write-offs —
  // and realization is precisely billable hours over total hours, so both have
  // to be recorded rather than one of them being dropped.
  billable  Boolean   @default(true)
  note      String?
  // "timer" | "manual". A timer's start and end are wall-clock facts; a manual
  // entry's are a human's recollection, and telling them apart matters when a
  // timesheet is questioned.
  source    String    @default("timer")
  // The employee's hourlyRate at the moment this was logged. Null when no rate
  // was set — the rollups then report hours and leave the amount blank.
  rateSnapshot Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, startedAt])
  @@index([clientId, projectId])
  @@index([activityId])
  // Finding the one running timer for an employee is the app's hottest time
  // query — it runs on every page that shows the timer bar.
  @@index([employeeId, endedAt])
}

// --- Task discussion ---------------------------------------------------------

// A comment on one checklist step, optionally a reply to another comment.
//
// ClientActivity.notes could not serve this: it's a single string, so the
// second person to write destroys the first person's note, and handoffs
// between reviewer layers are exactly where two people write about the same
// task. AssignmentNote couldn't either — it's engagement-level, has no
// threading and no way to direct a message at a particular person.
//
// Threading is ONE level deep by design: a root comment and its replies.
// Arbitrary nesting makes a handoff conversation harder to read, not easier,
// and every deeper reply can address its root instead. The constraint is
// enforced in the action layer (a reply to a reply is re-parented to the
// root), so the data can never hold a chain the UI can't render.
model TaskComment {
  id         String         @id @default(cuid())
  activityId String
  activity   ClientActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  // null = a root comment. Deleting a root takes its replies with it: a reply
  // orphaned from what it was answering is worse than no reply.
  parentId String?
  parent   TaskComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  TaskComment[] @relation("CommentThread")

  // SetNull, not Cascade: a departed employee's handoff note is often the only
  // record of why something was done, so it outlives their account. The UI
  // falls back to authorLabel.
  authorId String?
  author   Employee? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // Denormalized author name, for the same reason AuditEvent carries one.
  authorLabel String

  body String
  // Set when the body is edited, so a comment somebody changed after the fact
  // is visibly changed rather than quietly rewritten.
  editedAt DateTime?

  createdAt DateTime @default(now())

  mentions TaskCommentMention[]

  @@index([activityId, createdAt])
  @@index([parentId])
}

// One resolved @mention. Written at comment time from the names actually
// matched in the body (see src/lib/mentions.ts), not re-parsed on read: an
// employee who is renamed later must not lose the mention, and a body edited
// to remove a name must not un-notify someone who already read it.
model TaskCommentMention {
  id         String      @id @default(cuid())
  commentId  String
  comment    TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // null = unread. This is the whole notification model: no separate
  // notification table, because a mention IS the notification.
  readAt     DateTime?
  createdAt  DateTime    @default(now())

  @@unique([commentId, employeeId])
  @@index([employeeId, readAt])
}

// --- Client-facing requests --------------------------------------------------

// A single-purpose, tokenized link handed to a client so they can do the one
// thing the workflow is blocked on: send a document, or approve a report.
//
// "Document Received" and "Review done by Client" are real steps in the firm's
// checklist, and before this there was no way to either ask for them or let
// the client act — SubtaskKind.CLIENT_TASK was presentational. This is not a
// client portal: there is no client login, no account, and no view of anything
// but this one request. That is the point. A magic link with a hashed token and
// an expiry is a much smaller thing to get right than an authentication system
// for people outside the firm.
//
// Security shape, mirroring the password-reset design already in the app:
//   - Only a SHA-256 hash of the token is stored. The raw token exists in the
//     link and nowhere else, so a database read can't reopen a request.
//   - Plain SHA-256 and not a KDF, for the same reason as reset tokens: the
//     input is already 256 bits of randomness, so there is nothing to brute
//     force and a KDF would only add latency to every lookup.
//   - Expiry is a timestamp checked on every read, and CANCELLED kills a link
//     immediately. Neither depends on a job running.
//   - Completing a request does NOT mark the checklist step done. A client's
//     upload can't be allowed to satisfy the sequential-completion rule or a
//     reviewer sign-off; staff still tick the step. What the client's action
//     does is remove the waiting and the chasing, which was the actual
//     problem.
model ClientRequest {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Which accounting period the request is about, so a document the client
  // sends lands in the right period's Files tab.
  periodName String?
  // The step this unblocks. SetNull so revoking or regenerating a checklist
  // never destroys the record of what was asked of a client.
  activityId String?
  activity   ClientActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  kind   ClientRequestKind
  status ClientRequestStatus @default(OPEN)

  // What the client sees. `title` is the ask in one line ("August bank
  // statements"); `message` is the optional note under it.
  title   String
  message String?

  // SHA-256 of the raw token. Unique so a lookup is a single indexed read.
  tokenHash String   @unique
  expiresAt DateTime

  createdById String?
  createdBy   Employee? @relation("ClientRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // Denormalized, so "who asked for this" survives the asker leaving.
  createdByLabel String

  // --- The client's response ---
  completedAt DateTime?
  // Free text the responder typed as their name. Deliberately NOT treated as
  // identity: the token is the only authentication here, and this field is a
  // courtesy label, which is why it is never used for authorization.
  respondedByName String?
  responseNote    String?
  // APPROVAL only: true = approved, false = changes requested. null on an
  // UPLOAD request, and null on an approval nobody has answered yet.
  approved        Boolean?

  // How many times the link has been opened, and when it last was. Enough to
  // answer "did they even look at it" before someone picks up the phone.
  viewCount  Int       @default(0)
  lastViewedAt DateTime?

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, projectId])
  @@index([status, expiresAt])
  @@index([activityId])
}
